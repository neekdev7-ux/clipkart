# ClipNova GTA 6 Edition — copy to .env and fill in.
# The monitor + clip detection work with NO keys at all (yt-dlp discovery,
# rule-based scoring/SEO). Keys are only needed for YouTube Data API
# discovery (optional) and for uploading to your channel.

# Where jobs, streams, clips and the SQLite DB live (default: ./data)
CLIPNOVA_DATA=./data

# Whisper model size: tiny, base (default), small, medium, large-v3
# base is the best speed/quality trade-off on CPU.
WHISPER_MODEL=base

# Jobs per IP per hour for the cut-any-video form (default 3)
MAX_JOBS_PER_HOUR=3

# Optional: better SEO titles via LLM (rule-based fallback if unset/failing).
# Set at most one; Gemini is checked first.
GEMINI_API_KEY=
OPENAI_API_KEY=

# --- YouTube OAuth (needed ONLY for uploading to your channel) ---
# From Google Cloud Console (see README for exact steps). Either set
# these two env vars OR place a downloaded client_secret.json next to
# the app. Never commit real values.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Optional: path to a downloaded OAuth client JSON (default: ./client_secret.json)
YOUTUBE_CLIENT_SECRET_FILE=./client_secret.json
# Where the OAuth token is stored after you authorize (default: data/token.json)
YOUTUBE_TOKEN_FILE=./data/token.json

# --- YouTube Data API v3 key (optional) ---
# Used for live-stream discovery + live-chat spikes. Without it the app
# falls back to yt-dlp search and scores without chat data.
YOUTUBE_API_KEY=

# --- Upload safety (DO NOT change until you are ready to go live) ---
# false (default) = dry-run: uploads are simulated and logged, nothing
# is ever sent to YouTube. Set true ONLY after connecting your channel
# via /auth/youtube and reviewing queued clips.
AUTO_UPLOAD=false
# One upload costs 1600 of the 10,000 default daily quota units.
# 6 uploads/day = 9600 units. Lower this if you use the same API key
# for other tools.
MAX_UPLOADS_PER_DAY=6

# --- Monitor ---
# Start the monitor automatically on boot (default false — start it
# from the dashboard or API when ready).
MONITOR_ON_START=false
# Comma-separated search queries for live GTA 6 streams.
GTA6_QUERIES=GTA 6 live,GTA VI live,GTA 6 gameplay,GTA 6 trailer,GTA 6 leak,GTA 6 Vice City,GTA 6 news
# Minimum concurrent viewers for a discovered stream to be watched.
MIN_VIEWERS=10
# Max streams recorded at the same time (CPU/disk bound).
MAX_WATCHED_STREAMS=3
# Seconds between discovery passes.
DISCOVERY_INTERVAL_SECONDS=120
# Segment length in minutes (each segment is transcribed + scored).
SEGMENT_MINUTES=5
# Hours of raw segments kept before auto-delete.
RETENTION_HOURS=2
# Disk cap for recorded segments (GB) — oldest deleted first.
DISK_CAP_GB=20
# Minimum GTA 6 score (0-100) for a clip to enter the queue.
CLIP_MIN_SCORE=60
# Max clips cut per segment.
MAX_CLIPS_PER_SEGMENT=2
# Target clip length in seconds (30-60).
CLIP_SECONDS=45
