# Copy to .env and fill in. No key is required — the app works fully
# rule-based without any API key.

# Where jobs, videos and the SQLite DB live (default: ./data)
CLIPNOVA_DATA=./data

# Whisper model size: tiny, base (default), small, medium, large-v3
# base is the best speed/quality trade-off on CPU.
WHISPER_MODEL=base

# Jobs per IP per hour (default 3)
MAX_JOBS_PER_HOUR=3

# Optional: better SEO titles via LLM (rule-based fallback if unset/failing).
# Set at most one; Gemini is checked first.
GEMINI_API_KEY=
OPENAI_API_KEY=
